# Archivos de la app Flutter que no se suben al repositorio: los generan la
# compilación, Flutter o el editor, y se vuelven a crear solos.

# Varios: registros, temporales y archivos de otros sistemas
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Android Studio e IntelliJ
*.iml
*.ipr
*.iws
.idea/

# La carpeta .vscode sí se sube: puede tener configuraciones de VS Code útiles para
# todo el equipo.

# Flutter, Dart y pub (paquetes descargados y compilaciones)
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Símbolos para leer los errores de una versión ofuscada
app.*.symbols

# Mapa de la ofuscación
app.*.map.json

# Lo que compila Android Studio
/android/app/debug
/android/app/profile
/android/app/release
