<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o superior muestra su propia pantalla de arranque (tarea T144):
     se le da el azul marino del fondo Aurora, versión para el modo oscuro. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
